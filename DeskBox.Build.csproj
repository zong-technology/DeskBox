<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>DeskBox</AssemblyName>
    <LangVersion>5</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationIcon>assets/deskbox.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Security" /><Reference Include="System.Drawing" /><Reference Include="System.Windows.Forms" />
    <Reference Include="System.Web.Extensions" /><Reference Include="System.IO.Compression" /><Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Management" /><Reference Include="System.Xml.Linq" /><Reference Include="Microsoft.VisualBasic" />
    <Compile Include="src/**/*.cs" />
    <EmbeddedResource Include="assets/engineering-factory.png" LogicalName="DeskBox.EngineeringFactory" />
    <EmbeddedResource Include="public/assets/silverwing-avatar.png" LogicalName="DeskBox.Silverwing" />
    <EmbeddedResource Include="skills/documents/worker.py" LogicalName="DeskBox.DocumentWorker" />
    <EmbeddedResource Include="skills/documents/SKILL.md" LogicalName="DeskBox.DocumentSkill" />
    <EmbeddedResource Include="skills/documents/windows-ocr.ps1" LogicalName="DeskBox.DocumentOcr" />
  </ItemGroup>
</Project>
